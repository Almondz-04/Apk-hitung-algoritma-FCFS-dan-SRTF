function updateProcess(index, field, value) {
    processes[index][field] = value === "" ? "" : Number(value);
}

function addProcess() {
    const nextNumber = processes.length + 1;

    processes.push({
        id: `P${nextNumber}`,
        arrival: 0,
        burst: 1
    });

    renderInput();
}

function removeProcess(index) {
    if (processes.length <= 1) {
        alert("Minimal harus ada satu proses.");
        return;
    }

    processes.splice(index, 1);

    // Renumber process IDs after deletion.
    processes.forEach((process, i) => {
        process.id = `P${i + 1}`;
    });

    renderInput();
}

function runSimulation() {
    if (processes.length === 0) {
        alert("Tambahkan minimal satu proses.");
        return;
    }

    const valid = processes.every(process =>
        Number.isInteger(process.arrival) &&
        process.arrival >= 0 &&
        Number.isInteger(process.burst) &&
        process.burst > 0
    );

    if (!valid) {
        alert(
            "Arrival Time harus bilangan bulat >= 0 " +
            "dan Burst Time harus bilangan bulat > 0."
        );
        return;
    }

    viewingHistory = false;

    if (selectedAlgorithm === "Comparison") {
        comparisonResult = {
            fcfs: calculateFCFS(processes),
            srtf: calculateSRTF(processes)
        };

        saveSimulation(
            "Comparison",
            processes,
            comparisonResult
        );

        renderComparison();
        return;
    }

    if (selectedAlgorithm === "FCFS") {
        lastResult = calculateFCFS(processes);
    } else if (selectedAlgorithm === "SRTF") {
        lastResult = calculateSRTF(processes);
    }

    saveSimulation(
        selectedAlgorithm,
        processes,
        lastResult
    );

    renderResults();
}

function calculateFCFS(input) {
    const sorted = input
        .map((process, index) => ({ ...process, originalIndex: index }))
        .sort((a, b) =>
            a.arrival - b.arrival ||
            a.originalIndex - b.originalIndex
        );

    let currentTime = 0;
    const results = [];
    const gantt = [];

    sorted.forEach(process => {
        const start = Math.max(currentTime, process.arrival);
        const completion = start + process.burst;

        if (currentTime < process.arrival) {
            gantt.push({
                id: "Idle",
                start: currentTime,
                end: process.arrival
            });
        }

        gantt.push({
            id: process.id,
            start,
            end: completion
        });

        const turnaround = completion - process.arrival;
        const waiting = turnaround - process.burst;
        const response = start - process.arrival;

        results.push({
            id: process.id,
            arrival: process.arrival,
            burst: process.burst,
            start,
            completion,
            turnaround,
            waiting,
            response
        });

        currentTime = completion;
    });

    const count = results.length;

    return {
        results,
        gantt,
        averageWaiting: results.reduce((sum, p) => sum + p.waiting, 0) / count,
        averageTurnaround: results.reduce((sum, p) => sum + p.turnaround, 0) / count,
        averageResponse: results.reduce((sum, p) => sum + p.response, 0) / count
    };
}

function calculateSRTF(input) {
    const jobs = input.map((process, index) => ({
        ...process,
        originalIndex: index,
        remaining: process.burst,
        firstStart: null,
        completion: null
    }));

    const gantt = [];
    let currentTime = 0;
    let completed = 0;

    while (completed < jobs.length) {
        const available = jobs
            .filter(p =>
                p.arrival <= currentTime &&
                p.remaining > 0
            )
            .sort((a, b) =>
                a.remaining - b.remaining ||
                a.arrival - b.arrival ||
                a.originalIndex - b.originalIndex
            );

        if (available.length === 0) {
            const nextArrival = Math.min(
                ...jobs
                    .filter(p => p.remaining > 0)
                    .map(p => p.arrival)
            );

            gantt.push({
                id: "Idle",
                start: currentTime,
                end: nextArrival
            });

            currentTime = nextArrival;
            continue;
        }

        const process = available[0];

        if (process.firstStart === null) {
            process.firstStart = currentTime;
        }

        const previous = gantt[gantt.length - 1];

        if (previous && previous.id === process.id) {
            previous.end = currentTime + 1;
        } else {
            gantt.push({
                id: process.id,
                start: currentTime,
                end: currentTime + 1
            });
        }

        process.remaining--;
        currentTime++;

        if (process.remaining === 0) {
            process.completion = currentTime;
            completed++;
        }
    }

    const results = jobs.map(process => {
        const turnaround =
            process.completion - process.arrival;

        const waiting =
            turnaround - process.burst;

        const response =
            process.firstStart - process.arrival;

        return {
            id: process.id,
            arrival: process.arrival,
            burst: process.burst,
            start: process.firstStart,
            completion: process.completion,
            turnaround,
            waiting,
            response
        };
    });

    const count = results.length;

    return {
        results,
        gantt,
        averageWaiting:
            results.reduce((sum, p) => sum + p.waiting, 0) / count,
        averageTurnaround:
            results.reduce((sum, p) => sum + p.turnaround, 0) / count,
        averageResponse:
            results.reduce((sum, p) => sum + p.response, 0) / count
    };
}

function getProcessColor(processId) {
    const colors = [
        "#789BB2", // Blue
        "#82A68E", // Green
        "#C9875B", // Orange
        "#A58BB5", // Purple
        "#D39A8C", // Dusty pink
        "#9C705B", // Brown
        "#8BA6A0"  // Teal
    ];

    if (processId === "Idle") {
        return "#A9A19A";
    }

    const processNumber = Number(processId.replace("P", ""));
    return colors[(processNumber - 1) % colors.length];
}

function renderComparisonGantt(result, title) {
    const totalTime = result.gantt[result.gantt.length - 1].end;
    const pixelPerUnit = 48;
    const chartWidth = totalTime * pixelPerUnit;

    return `
        <section class="comparison-result">
            <h3>${title}</h3>

            <div class="gantt-scroll">
                <div
                    class="gantt-chart"
                    style="width: ${chartWidth}px;"
                >
                    ${result.gantt.map(item => {
                        const duration = item.end - item.start;

                        return `
                            <div
                                class="gantt-item ${item.id === "Idle" ? "idle" : ""}"
                                style="
                                    flex: 0 0 ${duration * pixelPerUnit}px;
                                    background: ${getProcessColor(item.id)};
                                "
                            >
                                <strong>${item.id}</strong>
                                <small>${item.start} – ${item.end}</small>
                            </div>
                        `;
                    }).join("")}
                </div>

                <div
                    class="gantt-timeline"
                    style="width: ${chartWidth}px;"
                >
                    ${result.gantt.map(item => `
                        <span style="
                            flex: 0 0 ${(item.end - item.start) * pixelPerUnit}px;
                        ">
                            ${item.start}
                        </span>
                    `).join("")}

                    <span class="final-time">${totalTime}</span>
                </div>
            </div>
        </section>
    `;
}

