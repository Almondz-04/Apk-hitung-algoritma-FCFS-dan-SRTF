// Reopen previous simulation
function viewHistoryRecord(id) {
    const history = getSimulationHistory();

    const record = history.find(
        item => item.id === id
    );

    if (!record) {
        alert("Riwayat simulasi tidak ditemukan.");
        renderHistory();
        return;
    }

    selectedAlgorithm = record.algorithm;

    processes = JSON.parse(
        JSON.stringify(record.processes)
    );

    viewingHistory = true;

    if (record.algorithm === "Comparison") {
        comparisonResult = record.result;
        renderComparison();
    } else {
        lastResult = record.result;
        renderResults();
    }
}


// Delete one record
function deleteHistoryRecord(id) {
    const confirmed = confirm(
        "Apakah kamu yakin ingin menghapus riwayat ini?"
    );

    if (!confirmed) return;

    const history = getSimulationHistory();

    const updatedHistory = history.filter(
        record => record.id !== id
    );

    saveSimulationHistory(updatedHistory);

    renderHistory();
}


// Delete all records
function clearHistory() {
    const confirmed = confirm(
        "Apakah kamu yakin ingin menghapus semua riwayat simulasi?"
    );

    if (!confirmed) return;

    saveSimulationHistory([]);

    renderHistory();
}

