                    <thead>
                        <tr>
                            <th>Proses</th>
                            <th>AT</th>
                            <th>BT</th>
                            <th>CT</th>
                            <th>TAT</th>
                            <th>WT</th>
                            <th>RT</th>
                        </tr>
                    </thead>
                    <tbody>
                        ${result.results.map(p => `
                            <tr>
                                <td>${p.id}</td>
                                <td>${p.arrival}</td>
                                <td>${p.burst}</td>
                                <td>${p.completion}</td>
                                <td>${p.turnaround}</td>
                                <td>${p.waiting}</td>
                                <td>${p.response}</td>
                            </tr>
                        `).join("")}
                    </tbody>
                </table>
            </div>
        </section>

        <section class="average-card">
            <h2>Rata-rata</h2>

            <div class="average-row">
                <span>Waiting Time</span>
                <strong>${result.averageWaiting.toFixed(2)}</strong>
            </div>

            <div class="average-row">
                <span>Turnaround Time</span>
                <strong>${result.averageTurnaround.toFixed(2)}</strong>
            </div>

            <div class="average-row">
                <span>Response Time</span>
                <strong>${result.averageResponse.toFixed(2)}</strong>
            </div>
        </section>

        <button class="primary-button" onclick="returnFromResult()">
            ${viewingHistory ? "Kembali ke Riwayat" : "Kembali ke Input"}
        </button>

        ${renderNavigation("")}
    `;
}

function navigate(page) {
    if (page === "home") {
        renderHome();
    } else if (page === "history") {
        renderHistory();
    } else if (page === "about") {
        alert("Halaman Tentang AVIRA akan kita buat selanjutnya.");
    }
}

renderHome();
