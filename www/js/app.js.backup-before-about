function renderAverageComparison(label, fcfs, srtf) {
    const difference = Math.abs(fcfs - srtf);
    const winner = fcfs < srtf ? "FCFS" :
                   srtf < fcfs ? "SRTF" : "Sama";

    return `
        <div class="average-comparison-row">
            <span>${label}</span>

            <strong>${fcfs.toFixed(2)}</strong>

            <strong>${srtf.toFixed(2)}</strong>
        </div>

        <p class="metric-winner">
            ${winner === "Sama"
                ? "Hasil kedua algoritma sama."
                : `${winner} lebih rendah sebesar ${difference.toFixed(2)}.`
            }
        </p>
    `;
}

function getComparisonConclusion(fcfs, srtf) {
    const fcfsWT = fcfs.averageWaiting;
    const srtfWT = srtf.averageWaiting;

    if (fcfsWT < srtfWT) {
        return "Pada data proses ini, FCFS menghasilkan rata-rata Waiting Time yang lebih rendah dibandingkan SRTF.";
    }

    if (srtfWT < fcfsWT) {
        return "Pada data proses ini, SRTF menghasilkan rata-rata Waiting Time yang lebih rendah dibandingkan FCFS.";
    }

    return "Pada data proses ini, FCFS dan SRTF menghasilkan rata-rata Waiting Time yang sama.";
}

function returnFromResult() {
    if (viewingHistory) {
        viewingHistory = false;
        renderHistory();
    } else {
        renderInput();
